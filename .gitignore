# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Data & model artifacts (large; keep out of git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Anchored to repo root so it only ignores the trained-artifacts dir, NOT the
# `emotion_classification/models/` source package.
/models/
# Trained-artifact binaries are ignored (below); the experiment outputs in
# `results/` (CSV/JSON/PNG) are now published — see the results/ README key.
*.pt
*.pth
*.safetensors
*.bin
*.ckpt

# Caches / test
.cache/
.pytest_cache/
.mypy_cache/
*.log
# ...except the published GPU-server run logs, kept as result provenance.
!results/server_logs/
!results/server_logs/*.log

# Reproducibility lockfile is fine to commit; this ignores stray local freezes
# (intentionally NOT ignoring requirements.lock.txt)

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment / secrets
.env
*.env
