# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Data & model artifacts (large; keep out of git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Anchored to repo root so it only ignores the trained-artifacts dir, NOT the
# `emotion_classification/models/` source package.
/models/
# Persisted experiment outputs (scorecard CSV/JSON); regenerate via run_experiment.
/results/
*.pt
*.pth
*.safetensors
*.bin
*.ckpt

# Caches / test
.cache/
.pytest_cache/
.mypy_cache/
*.log

# Reproducibility lockfile is fine to commit; this ignores stray local freezes
# (intentionally NOT ignoring requirements.lock.txt)

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment / secrets
.env
*.env
